{
  "name": "sotoy-film",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "sync:tmdb": "tsx scripts/sync-tmdb-cron.ts",
    "build": "tsc --noEmit && tsx scripts/generate-sitemap.ts && vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test:middleware": "node --import tsx scripts/test-middleware.ts",
    "test:linkify": "node --import tsx scripts/test-linkify.ts",
    "test:profile-links": "node --import tsx scripts/test-profile-links.ts",
    "test:onboarding": "node --import tsx scripts/test-onboarding.ts",
    "test:film-sections": "node --import tsx scripts/test-film-sections.ts",
    "test:film-section-genre": "node --import tsx scripts/test-film-section-genre.ts",
    "test:home-film-sections": "node --import tsx scripts/test-home-film-sections.ts",
    "test:tmdb-sync": "node --import tsx scripts/test-tmdb-sync.ts",
    "test:tmdb-cron": "node --import tsx scripts/test-tmdb-cron.ts",
    "test:tmdb-id": "node --import tsx scripts/test-tmdb-id-match.ts",
    "test:api-imports": "node --import tsx scripts/test-api-imports.ts",
    "test:film-type": "node --import tsx scripts/test-film-type.ts",
    "test:article-category": "node --import tsx scripts/test-article-category.ts",
    "test:article-flow": "node --import tsx scripts/test-article-flow.ts",
    "test:image-optimize": "node --import tsx scripts/test-image-optimize.ts",
    "test:migrate-article-images": "node --import tsx scripts/test-migrate-article-images.ts",
    "test:film-card": "node --import tsx scripts/test-film-card.ts",
    "test:share-card": "node --import tsx scripts/test-share-card.ts",
    "test:collections": "node --import tsx scripts/test-collections.ts",
    "test:collection-social": "node --import tsx scripts/test-collection-social.ts",
    "test:saved-buzz": "node --import tsx scripts/test-saved-buzz.ts",
    "test:collection-share-layout": "node --import tsx scripts/test-collection-share-layout.ts",
    "test:share-analytics": "node --import tsx scripts/test-share-analytics.ts",
    "test:collection-preview": "node --import tsx scripts/test-collection-preview.ts",
     "test:embeds": "node --import tsx scripts/test-embeds.ts && node --import tsx scripts/test-embeds.iframe.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@dr.pogodin/react-helmet": "^3.3.2",
    "@tiptap/extension-character-count": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-table-cell": "^3.32.0",
    "@tiptap/extension-table-header": "^3.32.0",
    "@tiptap/extension-table-row": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "@vercel/edge": "^1.3.3",
    "browser-image-compression": "^2.0.2",
    "dompurify": "^3.4.17",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.546.0",
    "motion": "^13.3.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-easy-crop": "^6.2.3",
    "react-is": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/dompurify": "^3.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.2",
    "firebase-admin": "^14.5.0",
    "googleapis": "^185.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
