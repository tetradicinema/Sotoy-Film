{
  "name": "sotoy-film",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "build": "tsx scripts/generate-sitemap.ts && vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test:middleware": "tsx scripts/test-middleware.ts",
    "migrate:removed-mock-films": "tsx scripts/migrate-removed-mock-films.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@dr.pogodin/react-helmet": "^3.3.2",
    "@vercel/edge": "^1.3.3",
    "browser-image-compression": "^2.0.2",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.546.0",
    "motion": "^13.3.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-easy-crop": "^6.2.3",
    "react-is": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
