{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile database document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "avatar": { "type": "string" },
        "role": { "type": "string", "enum": ["warga_sotoy", "si_paling_sotoy", "penulis_sotoy", "admin"] },
        "roleTitle": { "type": "string" },
        "bio": { "type": "string" },
        "isSuspended": { "type": "boolean" },
        "suspendedAt": { "type": "string" },
        "totalReviews": { "type": "integer" },
        "totalBuzz": { "type": "integer" },
        "followers": { "type": "array" },
        "following": { "type": "array" },
        "interestProfile": { "type": "object" },
        "lastInterestDecay": { "type": "string" }
      },
      "required": ["id", "name", "handle", "role"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Private user information such as email address",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "updatedAt"]
    },
    "Article": {
      "title": "Article",
      "description": "Article document written by writers or admins",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "coverImage": { "type": "string" },
        "category": { "type": "string" },
        "subCategory": { "type": "string" },
        "author": { "type": "object" },
        "publishedAt": { "type": "string" },
        "readTime": { "type": "string" },
        "views": { "type": "integer" },
        "likes": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "tags": { "type": "array" }
      },
      "required": ["id", "title", "content", "category", "author"]
    },
    "FilmItem": {
      "title": "FilmItem",
      "description": "Film item in the film database",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["movie", "series", "anime"] },
        "year": { "type": "integer" },
        "poster": { "type": "string" },
        "backdrop": { "type": "string" },
        "synopsis": { "type": "string" },
        "director": { "type": "string" },
        "cast": { "type": "array" },
        "genres": { "type": "array" },
        "skorSotoy": { "type": "number" },
        "totalVotes": { "type": "integer" },
        "criticsSkorSotoy": { "type": "number" }
      },
      "required": ["id", "title", "type", "year", "genres"]
    },
    "BuzzPost": {
      "title": "BuzzPost",
      "description": "Community buzz feed post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "author": { "type": "object" },
        "content": { "type": "string" },
        "image": { "type": "string" },
        "createdAt": { "type": "string" },
        "likes": { "type": "integer" },
        "repliesCount": { "type": "integer" },
        "repostsCount": { "type": "integer" },
        "repostedByUsers": { "type": "object" },
        "tags": { "type": "array" }
      },
      "required": ["id", "author", "content", "createdAt"]
    },
    "UserRating": {
      "title": "UserRating",
      "description": "A review or score left on a film by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "filmId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "userRole": { "type": "string" },
        "score": { "type": "number" },
        "headline": { "type": "string" },
        "reviewText": { "type": "string" },
        "createdAt": { "type": "string" },
        "likes": { "type": "integer" }
      },
      "required": ["id", "filmId", "userId", "score", "createdAt"]
    },
    "CriticSubmission": {
      "title": "CriticSubmission",
      "description": "A submission to become a verfied critic",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "publicationName": { "type": "string" },
        "publicationUrl": { "type": "string" },
        "portfolioUrl": { "type": "string" },
        "twitterHandle": { "type": "string" },
        "motivation": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] }
      },
      "required": ["id", "userId", "userName", "userEmail", "status"]
    },
    "UploadedFile": {
      "title": "UploadedFile",
      "description": "Uploaded media file metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "url": { "type": "string" },
        "name": { "type": "string" },
        "size": { "type": "integer" },
        "type": { "type": "string" },
        "uploadedAt": { "type": "string" }
      },
      "required": ["id", "userId", "url", "name", "size", "type", "uploadedAt"]
    },
    "ArticlePresence": {
      "title": "ArticlePresence",
      "description": "Realtime active co-editing presence",
      "type": "object",
      "properties": {
        "articleId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "roleTitle": { "type": "string" },
        "lastActive": { "type": "number" }
      },
      "required": ["articleId", "userId", "userName", "lastActive"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notifications for users and writers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["comment", "like", "mention", "reply", "editor_request", "follow", "reaction", "account_status"] },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "targetView": { "type": "string" },
        "targetId": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "sender": { "type": "object" }
      },
      "required": ["id", "userId", "type", "title", "message", "targetView", "isRead", "createdAt", "sender"]
    },
    "AccountAppeal": {
      "title": "AccountAppeal",
      "description": "Appeals from suspended users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userHandle": { "type": "string" },
        "userEmail": { "type": "string" },
        "userAvatar": { "type": "string" },
        "userRole": { "type": "string" },
        "reason": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "adminNote": { "type": "string" },
        "resolvedAt": { "type": "string" }
      },
      "required": ["id", "userId", "userName", "reason", "createdAt", "status"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System and moderation audit logs for tracking administrative actions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "actorId": { "type": "string" },
        "actorName": { "type": "string" },
        "actorEmail": { "type": "string" },
        "actorRole": { "type": "string" },
        "actorAvatar": { "type": "string" },
        "targetId": { "type": "string" },
        "targetName": { "type": "string" },
        "targetEmail": { "type": "string" },
        "targetRole": { "type": "string" },
        "targetType": { "type": "string" },
        "details": { "type": "string" },
        "metadata": { "type": "object" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "action", "actorId", "actorName", "timestamp"]
    },
    "RemovedMockFilm": {
      "title": "RemovedMockFilm",
      "description": "Marker document for INITIAL_FILMS mock items removed from global catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "removedAt": { "type": "string" }
      },
      "required": ["id", "removedAt"]
    },
    "WatchlistItem": {
      "title": "WatchlistItem",
      "description": "User's saved film item in their personal watchlist",
      "type": "object",
      "properties": {
        "filmId": { "type": "string" },
        "addedAt": { "type": "string" }
      },
      "required": ["addedAt"]
    },
    "SavedArticleItem": {
      "title": "SavedArticleItem",
      "description": "User's saved article item in their personal library",
      "type": "object",
      "properties": {
        "articleId": { "type": "string" },
        "addedAt": { "type": "string" }
      },
      "required": ["addedAt"]
    },
    "SavedBuzzItem": {
      "title": "SavedBuzzItem",
      "description": "User's saved community buzz post in their personal bookmarks",
      "type": "object",
      "properties": {
        "buzzId": { "type": "string" },
        "addedAt": { "type": "string" }
      },
      "required": ["addedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/watchlist/{filmId}": {
      "schema": "WatchlistItem",
      "description": "Personal watchlist of films for a specific user"
    },
    "/users/{userId}/savedArticles/{articleId}": {
      "schema": "SavedArticleItem",
      "description": "Personal saved library of articles for a specific user"
    },
    "/users/{userId}/savedBuzz/{buzzId}": {
      "schema": "SavedBuzzItem",
      "description": "Personal bookmarked buzz posts for a specific user"
    },
    "/removedMockFilms/{filmId}": {
      "schema": "RemovedMockFilm",
      "description": "Markers for mock films that have been removed from the global catalog"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Administrative audit logs"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Profiles of the users"
    },
    "/userPrivate/{userId}": {
      "schema": "UserPrivate",
      "description": "Private user information accessible only to the user and admins"
    },
    "/files/{fileId}": {
      "schema": "UploadedFile",
      "description": "Metadata for user uploaded files and media"
    },
    "/articles/{articleId}": {
      "schema": "Article",
      "description": "Articles published on the website"
    },
    "/article_presence/{presenceId}": {
      "schema": "ArticlePresence",
      "description": "Active co-editing presence tracking"
    },
    "/films/{filmId}": {
      "schema": "FilmItem",
      "description": "Film titles database"
    },
    "/buzz/{buzzId}": {
      "schema": "BuzzPost",
      "description": "Posts in the community feed"
    },
    "/ratings/{ratingId}": {
      "schema": "UserRating",
      "description": "Ratings left on films"
    },
    "/criticSubmissions/{submissionId}": {
      "schema": "CriticSubmission",
      "description": "Critic submissions"
    },
    "/appeals/{appealId}": {
      "schema": "AccountAppeal",
      "description": "Account suspension appeals"
    }
  }
}
