rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net - Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'CsG2CY2TaIZmG7yuPfzAxmRYrlY2' ||
        request.auth.uid == 'QkNGf1ZfhsMyUEk90a6Iz8ZplZS2' ||
        request.auth.uid == 'I34eqzOmvsSdS2Rf7jpfxw1ZKeu1' ||
        (request.auth.token.email in ['eksposurmedia@gmail.com', 'admin1@sotoyfilm.id', 'admin2@sotoyfilm.id']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin')
      );
    }

    function isWriter() {
      return isSignedIn() && (
        request.auth.uid == '0PCmaBvJrzeaQgpf3sSTC4mnsh02' ||
        request.auth.uid == 'Jm0raI2h47TJG9ZtZAR1HLVcjSj2' ||
        isAdmin() ||
        (request.auth.token.email in ['eksposurmedia@gmail.com', 'admin1@sotoyfilm.id', 'admin2@sotoyfilm.id']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role in ['penulis_sotoy', 'admin'])
      );
    }

    function isCritic() {
      return isSignedIn() && (
        request.auth.uid == 'Jm0raI2h47TJG9ZtZAR1HLVcjSj2' ||
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role in ['si_paling_sotoy', 'admin'])
      );
    }

    function isSuspended() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getUserData().get('isSuspended', false) == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validations
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'handle', 'role']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() <= 128 &&
        data.handle is string && data.handle.size() <= 128 &&
        data.role in ['warga_sotoy', 'si_paling_sotoy', 'penulis_sotoy', 'admin'];
    }

    function isValidFile(data) {
      return data.keys().hasAll(['id', 'userId', 'url', 'name', 'size', 'type', 'uploadedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.url is string && data.url.size() <= 2000000 &&
        data.name is string && data.name.size() <= 256 &&
        data.size is int &&
        data.type is string && data.type.size() <= 128 &&
        data.uploadedAt is string && data.uploadedAt.size() <= 128;
    }

    function isValidArticle(data) {
      return data.keys().hasAll(['id', 'title', 'content', 'category', 'author']) &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() <= 200 &&
        data.content is string && data.content.size() <= 50000 &&
        data.category is string &&
        data.author is map &&
        data.author.id is string &&
        (data.author.id == request.auth.uid || isAdmin() || request.auth.uid == '0PCmaBvJrzeaQgpf3sSTC4mnsh02' || request.auth.uid == 'Jm0raI2h47TJG9ZtZAR1HLVcjSj2');
    }

    function isValidFilmItem(data) {
      return data.keys().hasAll(['id', 'title', 'type', 'year', 'genres']) &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() <= 200 &&
        data.type in ['movie', 'series', 'anime'] &&
        (data.year is int || data.year is number) &&
        data.genres is list;
    }

    function isValidBuzzPost(data) {
      return data.keys().hasAll(['id', 'author', 'content', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.content is string && data.content.size() <= 2000 &&
        data.author is map &&
        data.author.id is string &&
        (!('upvotes' in data) || data.upvotes is list) &&
        (!('downvotes' in data) || data.downvotes is list);
    }

    function isValidUserRating(data) {
      return data.keys().hasAll(['id', 'filmId', 'userId', 'score', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.filmId is string && data.filmId.size() <= 128 &&
        data.userId is string && (data.userId == request.auth.uid || isAdmin() || isWriter() || isSignedIn()) &&
        data.score is number && data.score >= 0.5 && data.score <= 5.0;
    }

    function isValidCriticSubmission(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'userEmail', 'status']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.status in ['pending', 'approved', 'rejected'];
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'userId', 'type', 'title', 'message', 'targetView', 'isRead', 'createdAt', 'sender']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.type in ['comment', 'like', 'mention', 'reply', 'editor_request', 'follow', 'reaction', 'account_status'] &&
        data.title is string && data.title.size() <= 200 &&
        data.message is string && data.message.size() <= 1000 &&
        data.targetView is string && data.targetView.size() <= 128 &&
        data.isRead is bool &&
        data.createdAt is string &&
        data.sender is map &&
        data.sender.id is string;
    }

    // Granular delta & diff validation helpers
    function isValidFollowersCountDelta() {
      let prev = ('followersCount' in existing()) ? existing().followersCount : 0;
      let next = incoming().followersCount;
      return next == prev + 1 || next == prev - 1;
    }

    function isValidFollowingCountDelta() {
      let prev = ('followingCount' in existing()) ? existing().followingCount : 0;
      let next = incoming().followingCount;
      return next == prev + 1 || next == prev - 1;
    }

    function isValidFollowersArrayUpdate() {
      let prev = ('followers' in existing()) ? existing().followers : [];
      let next = incoming().followers;
      return (next.removeAll(prev) == [request.auth.uid] && prev.removeAll(next) == []) ||
             (prev.removeAll(next) == [request.auth.uid] && next.removeAll(prev) == []);
    }

    function isValidFollowingArrayUpdate() {
      let prev = ('following' in existing()) ? existing().following : [];
      let next = incoming().following;
      return (next.removeAll(prev) == [request.auth.uid] && prev.removeAll(next) == []) ||
             (prev.removeAll(next) == [request.auth.uid] && next.removeAll(prev) == []);
    }

    function isValidReactionsByUserUpdate() {
      let prev = ('reactionsByUser' in existing()) ? existing().reactionsByUser : {};
      let next = ('reactionsByUser' in incoming()) ? incoming().reactionsByUser : {};
      return next.diff(prev).affectedKeys().hasOnly([request.auth.uid]) &&
             (!(request.auth.uid in next) || (next[request.auth.uid] in ['heart', 'mindblown', 'fire', 'laugh', 'clap']));
    }

    function isValidRepliesCountDelta() {
      let prev = ('repliesCount' in existing()) ? existing().repliesCount : 0;
      let next = incoming().repliesCount;
      return next == prev + 1 || next == prev - 1;
    }

    function isValidReactionsAggregateUpdate() {
      let prev = ('reactions' in existing()) ? existing().reactions : {heart:0, mindblown:0, fire:0, laugh:0, clap:0};
      let next = incoming().reactions;
      
      let deltaHeart = next.get('heart', 0) - prev.get('heart', 0);
      let deltaMindblown = next.get('mindblown', 0) - prev.get('mindblown', 0);
      let deltaFire = next.get('fire', 0) - prev.get('fire', 0);
      let deltaLaugh = next.get('laugh', 0) - prev.get('laugh', 0);
      let deltaClap = next.get('clap', 0) - prev.get('clap', 0);

      let netDelta = deltaHeart + deltaMindblown + deltaFire + deltaLaugh + deltaClap;

      return deltaHeart >= -1 && deltaHeart <= 1 &&
             deltaMindblown >= -1 && deltaMindblown <= 1 &&
             deltaFire >= -1 && deltaFire <= 1 &&
             deltaLaugh >= -1 && deltaLaugh <= 1 &&
             deltaClap >= -1 && deltaClap <= 1 &&
             (netDelta == 0 || netDelta == 1 || netDelta == -1);
    }

    function isValidLikesDelta() {
      let prev = ('likes' in existing()) ? existing().likes : 0;
      let next = incoming().likes;
      return next == prev + 1 || next == prev - 1 || next == prev;
    }

    function isValidVotesUpdate() {
      let prevUp = ('upvotes' in existing()) ? existing().upvotes : [];
      let nextUp = ('upvotes' in incoming()) ? incoming().upvotes : [];
      let prevDown = ('downvotes' in existing()) ? existing().downvotes : [];
      let nextDown = ('downvotes' in incoming()) ? incoming().downvotes : [];
      
      let addedUp = nextUp.toSet().difference(prevUp.toSet());
      let removedUp = prevUp.toSet().difference(nextUp.toSet());
      let addedDown = nextDown.toSet().difference(prevDown.toSet());
      let removedDown = prevDown.toSet().difference(nextDown.toSet());

      return addedUp.hasOnly([request.auth.uid]) && 
             removedUp.hasOnly([request.auth.uid]) &&
             addedDown.hasOnly([request.auth.uid]) &&
             removedDown.hasOnly([request.auth.uid]) &&
             // Ensure likes field matches the score
             incoming().likes == nextUp.size() - nextDown.size();
    }

    // Rules for each collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && (
        // Document Owner updating profile / interests / following
        (isOwner(userId) && isValidUser(incoming()) && (incoming().role == existing().role || userId == '0PCmaBvJrzeaQgpf3sSTC4mnsh02') && (
          !('followersCount' in incoming().diff(existing()).affectedKeys()) || isValidFollowersCountDelta()
        ) && (
          !('followingCount' in incoming().diff(existing()).affectedKeys()) || isValidFollowingCountDelta()
        ) && (
          !('following' in incoming().diff(existing()).affectedKeys()) || isValidFollowingArrayUpdate()
        ) && (
          !('followers' in incoming().diff(existing()).affectedKeys()) || isValidFollowersArrayUpdate()
        )) ||
        // Non-Owner (e.g. User A) updating User B's followersCount or followers array
        (!isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'followers']) && (
          !('followersCount' in incoming().diff(existing()).affectedKeys()) || isValidFollowersCountDelta()
        ) && (
          !('followers' in incoming().diff(existing()).affectedKeys()) || isValidFollowersArrayUpdate()
        )) ||
        isAdmin() ||
        isWriter()
      );
      allow delete: if isAdmin();

      match /meta/{docId} {
        allow read: if true;
        allow write: if isSignedIn() && (isOwner(userId) || isAdmin() || isWriter());
      }
    }

    match /follows/{followId} {
      allow read: if true;
      allow create: if isSignedIn() && (incoming().followerId == request.auth.uid || isAdmin() || isWriter());
      allow delete: if isSignedIn() && (resource.data.followerId == request.auth.uid || isAdmin() || isWriter());
    }

    match /article_presence/{presenceId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /files/{fileId} {
      allow read, update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isWriter());
      allow create: if isSignedIn() && ((incoming().userId == request.auth.uid && isValidFile(incoming())) || isAdmin() || isWriter());
    }

    match /articles/{articleId} {
      allow read: if true;
      allow create: if isSignedIn() && !isSuspended() && isValidId(articleId) && isValidArticle(incoming()) && (
        isWriter() ||
        isAdmin() ||
        request.auth.uid == '0PCmaBvJrzeaQgpf3sSTC4mnsh02' ||
        request.auth.uid == 'Jm0raI2h47TJG9ZtZAR1HLVcjSj2' ||
        incoming().author.id == request.auth.uid
      );
      allow update: if isSignedIn() && !isSuspended() && isValidId(articleId) && isValidArticle(incoming()) && (
        isOwner(existing().author.id) || 
        isAdmin() || 
        isWriter() ||
        (request.auth.uid == '0PCmaBvJrzeaQgpf3sSTC4mnsh02' && (existing().author.id == request.auth.uid || incoming().author.id == request.auth.uid)) ||
        (request.auth.uid == 'Jm0raI2h47TJG9ZtZAR1HLVcjSj2' && (existing().author.id == request.auth.uid || incoming().author.id == request.auth.uid))
      );
      allow delete: if isSignedIn() && !isSuspended() && (
        isOwner(existing().author.id) || 
        isAdmin() || 
        isWriter() ||
        (request.auth.uid == '0PCmaBvJrzeaQgpf3sSTC4mnsh02' && existing().author.id == request.auth.uid) ||
        (request.auth.uid == 'Jm0raI2h47TJG9ZtZAR1HLVcjSj2' && existing().author.id == request.auth.uid)
      );
    }

    match /films/{filmId} {
      allow read: if true;
      allow create, update: if (isAdmin() || isWriter()) && isValidId(filmId) && isValidFilmItem(incoming());
      allow delete: if (isAdmin() || isWriter()) && isValidId(filmId);
    }

    match /buzz/{buzzId} {
      allow read: if true;
      allow create: if isSignedIn() && !isSuspended() && isValidId(buzzId) && isValidBuzzPost(incoming());
      allow update: if isSignedIn() && (
        (!isSuspended() && isOwner(existing().author.id) && isValidBuzzPost(incoming())) ||
        (!isSuspended() && incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'reactions', 'reactionsByUser', 'replies', 'repliesCount', 'upvotes', 'downvotes']) && (
          !('reactionsByUser' in incoming().diff(existing()).affectedKeys()) || isValidReactionsByUserUpdate()
        ) && (
          !('reactions' in incoming().diff(existing()).affectedKeys()) || isValidReactionsAggregateUpdate()
        ) && (
          !('upvotes' in incoming().diff(existing()).affectedKeys() || 'downvotes' in incoming().diff(existing()).affectedKeys() || 'likes' in incoming().diff(existing()).affectedKeys()) || isValidVotesUpdate()
        ) && (
          !('repliesCount' in incoming().diff(existing()).affectedKeys()) || isValidRepliesCountDelta()
        )) ||
        isAdmin() ||
        isWriter()
      );
      allow delete: if isSignedIn() && (isOwner(existing().author.id) || isAdmin() || isWriter());
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn() && !isSuspended() && isValidId(ratingId) && isValidUserRating(incoming());
      allow update: if isSignedIn() && (
        (!isSuspended() && isOwner(existing().userId) && isValidUserRating(incoming())) ||
        (!isSuspended() && incoming().diff(existing()).affectedKeys().hasOnly(['likes']) && isValidLikesDelta()) ||
        (isCritic() && isOwner(existing().userId) && !isSuspended())
      );
      allow delete: if isSignedIn() && (isOwner(existing().userId) || isAdmin() || isWriter() || (isCritic() && isOwner(existing().userId)));
    }

    match /criticSubmissions/{submissionId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin() || isWriter());
      allow create: if isSignedIn() && isValidId(submissionId) && isValidCriticSubmission(incoming()) && incoming().status == 'pending';
      allow update: if isSignedIn() && isValidId(submissionId) && (
        (isOwner(existing().userId) && isValidCriticSubmission(incoming()) && incoming().status == existing().status) ||
        isAdmin() ||
        isWriter()
      );
      allow delete: if isAdmin() || isWriter();
    }

    match /reports/{reportId} {
      allow read: if isAdmin() || isWriter();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || isWriter();
    }

    match /notifications/{notificationId} {
      allow read, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isWriter());
      allow create: if isSignedIn() && !isSuspended() && isValidId(notificationId) && isValidNotification(incoming()) && (incoming().sender.id == request.auth.uid || isAdmin() || isWriter());
      allow update: if isSignedIn() && isValidId(notificationId) && (
        (resource.data.userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])) ||
        isAdmin() ||
        isWriter()
      );
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isWriter());
    }

    match /appeals/{appealId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin() || isWriter());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().status == 'pending';
      allow update, delete: if isAdmin() || isWriter();
    }

    match /auditLogs/{logId} {
      allow read: if isSignedIn() && (isAdmin() || isWriter());
      allow create: if isSignedIn() && (isAdmin() || isWriter());
      allow update, delete: if isAdmin();
    }
  }
}
