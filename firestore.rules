rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net - Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'CsG2CY2TaIZmG7yuPfzAxmRYrlY2' ||
        request.auth.uid == 'QkNGf1ZfhsMyUEk90a6Iz8ZplZS2' ||
        request.auth.uid == 'I34eqzOmvsSdS2Rf7jpfxw1ZKeu1' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin')
      );
    }

    function isWriter() {
      return isSignedIn() && (
        request.auth.uid == '0PCmaBvJrzeaQgpf3sSTC4mnsh02' ||
        request.auth.uid == 'Jm0raI2h47TJG9ZtZAR1HLVcjSj2' ||
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role in ['penulis_sotoy', 'admin'])
      );
    }

    function isCritic() {
      return isSignedIn() && (
        request.auth.uid == 'Jm0raI2h47TJG9ZtZAR1HLVcjSj2' ||
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role in ['si_paling_sotoy', 'admin'])
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validations
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'handle', 'role']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() <= 128 &&
        data.handle is string && data.handle.size() <= 128 &&
        data.role in ['warga_sotoy', 'si_paling_sotoy', 'penulis_sotoy', 'admin'];
    }

    function isValidFile(data) {
      return data.keys().hasAll(['id', 'userId', 'url', 'name', 'size', 'type', 'uploadedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.url is string && data.url.size() <= 2000000 &&
        data.name is string && data.name.size() <= 256 &&
        data.size is int &&
        data.type is string && data.type.size() <= 128 &&
        data.uploadedAt is string && data.uploadedAt.size() <= 128;
    }

    function isValidArticle(data) {
      return data.keys().hasAll(['id', 'title', 'content', 'category', 'author']) &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() <= 200 &&
        data.content is string && data.content.size() <= 50000 &&
        data.category is string &&
        data.author is map &&
        data.author.id is string &&
        (data.author.id == request.auth.uid || isAdmin() || request.auth.uid == '0PCmaBvJrzeaQgpf3sSTC4mnsh02' || request.auth.uid == 'Jm0raI2h47TJG9ZtZAR1HLVcjSj2');
    }

    function isValidFilmItem(data) {
      return data.keys().hasAll(['id', 'title', 'type', 'year', 'genres']) &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() <= 200 &&
        data.type in ['movie', 'series', 'anime'] &&
        data.year is int &&
        data.genres is list;
    }

    function isValidBuzzPost(data) {
      return data.keys().hasAll(['id', 'author', 'content', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.content is string && data.content.size() <= 1000 &&
        data.author is map &&
        data.author.id is string &&
        data.author.id == request.auth.uid;
    }

    function isValidUserRating(data) {
      return data.keys().hasAll(['id', 'filmId', 'userId', 'score', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.filmId is string && data.filmId.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.score is number && data.score >= 0.5 && data.score <= 5.0;
    }

    function isValidCriticSubmission(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'userEmail', 'status']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.status in ['pending', 'approved', 'rejected'];
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'userId', 'type', 'title', 'message', 'targetView', 'isRead', 'createdAt', 'sender']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.type in ['comment', 'like', 'mention', 'reply', 'editor_request', 'follow'] &&
        data.title is string && data.title.size() <= 200 &&
        data.message is string && data.message.size() <= 1000 &&
        data.targetView is string && data.targetView.size() <= 128 &&
        data.isRead is bool &&
        data.createdAt is string &&
        data.sender is map &&
        data.sender.id is string;
    }

    // Rules for each collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && (
        (isOwner(userId) && isValidUser(incoming()) && (incoming().role == existing().role || userId == '0PCmaBvJrzeaQgpf3sSTC4mnsh02')) || 
        isAdmin() ||
        isWriter()
      );
      allow delete: if isAdmin();
    }

    match /article_presence/{presenceId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /files/{fileId} {
      allow read, update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isWriter());
      allow create: if isSignedIn() && ((incoming().userId == request.auth.uid && isValidFile(incoming())) || isAdmin() || isWriter());
    }

    match /articles/{articleId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(articleId) && isValidArticle(incoming()) && (
        isWriter() ||
        isAdmin() ||
        request.auth.uid == '0PCmaBvJrzeaQgpf3sSTC4mnsh02' ||
        request.auth.uid == 'Jm0raI2h47TJG9ZtZAR1HLVcjSj2' ||
        incoming().author.id == request.auth.uid
      );
      allow update: if isSignedIn() && isValidId(articleId) && isValidArticle(incoming()) && (
        isOwner(existing().author.id) || 
        isAdmin() || 
        isWriter() ||
        (request.auth.uid == '0PCmaBvJrzeaQgpf3sSTC4mnsh02' && (existing().author.id == request.auth.uid || incoming().author.id == request.auth.uid)) ||
        (request.auth.uid == 'Jm0raI2h47TJG9ZtZAR1HLVcjSj2' && (existing().author.id == request.auth.uid || incoming().author.id == request.auth.uid))
      );
      allow delete: if isSignedIn() && (
        isOwner(existing().author.id) || 
        isAdmin() || 
        isWriter() ||
        (request.auth.uid == '0PCmaBvJrzeaQgpf3sSTC4mnsh02' && existing().author.id == request.auth.uid) ||
        (request.auth.uid == 'Jm0raI2h47TJG9ZtZAR1HLVcjSj2' && existing().author.id == request.auth.uid)
      );
    }

    match /films/{filmId} {
      allow read: if true;
      allow create, update, delete: if (isAdmin() || isWriter()) && isValidId(filmId) && isValidFilmItem(incoming());
    }

    match /buzz/{buzzId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(buzzId) && isValidBuzzPost(incoming());
      allow update: if isSignedIn() && isValidId(buzzId) && (
        (isOwner(existing().author.id) && isValidBuzzPost(incoming())) ||
        // Allowing simple like increments by other users
        (incoming().diff(existing()).affectedKeys().hasOnly(['likes']))
      );
      allow delete: if isSignedIn() && (isOwner(existing().author.id) || isAdmin() || isWriter());
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(ratingId) && isValidUserRating(incoming());
      allow update: if isSignedIn() && isValidId(ratingId) && (
        (isOwner(existing().userId) && isValidUserRating(incoming())) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['likes'])) ||
        (isCritic() && isOwner(existing().userId))
      );
      allow delete: if isSignedIn() && (isOwner(existing().userId) || isAdmin() || isWriter() || (isCritic() && isOwner(existing().userId)));
    }

    match /criticSubmissions/{submissionId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin() || isWriter());
      allow create: if isSignedIn() && isValidId(submissionId) && isValidCriticSubmission(incoming()) && incoming().status == 'pending';
      allow update: if isSignedIn() && isValidId(submissionId) && (
        (isOwner(existing().userId) && isValidCriticSubmission(incoming()) && incoming().status == existing().status) || // owner can edit motivation but not change status
        isAdmin() ||
        isWriter()
      );
      allow delete: if isAdmin() || isWriter();
    }

    match /reports/{reportId} {
      allow read: if isAdmin() || isWriter();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || isWriter();
    }

    match /notifications/{notificationId} {
      allow read, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isWriter());
      allow create: if isSignedIn() && isValidId(notificationId) && isValidNotification(incoming()) && (incoming().sender.id == request.auth.uid || isAdmin() || isWriter());
      allow update: if isSignedIn() && isValidId(notificationId) && (
        (resource.data.userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])) ||
        isAdmin() ||
        isWriter()
      );
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isWriter());
    }
  }
}
