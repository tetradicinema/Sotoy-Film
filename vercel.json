{
  "functions": {
    "api/sitemap.ts": {
      "includeFiles": "{data/sitemap-snapshot.xml,public/sitemap.xml}"
    }
  },
  "headers": [
    {
      "source": "/search",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/buzz/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/film", "destination": "/film-database", "permanent": true },
    { "source": "/kategori/anime", "destination": "/kategori/animation", "permanent": true },
    { "source": "/kategori/anime/:path*", "destination": "/kategori/animation/:path*", "permanent": true },
    { "source": "/kategori/animasi", "destination": "/kategori/animation", "permanent": true },
    { "source": "/kategori/animasi/:path*", "destination": "/kategori/animation/:path*", "permanent": true },
    { "source": "/category/anime", "destination": "/kategori/animation", "permanent": true },
    { "source": "/category/anime/:path*", "destination": "/kategori/animation/:path*", "permanent": true },
    { "source": "/category/animasi", "destination": "/kategori/animation", "permanent": true },
    { "source": "/category/animasi/:path*", "destination": "/kategori/animation/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/sitemap_index.xml", "destination": "/api/sitemap" },
    { "source": "/sitemap.csv", "destination": "/api/sitemap?format=csv" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/((?!api/|sitemap\\.xml|sitemap_index\\.xml|sitemap\\.csv|robots\\.txt|llms\\.txt|.*\\..*).*)", "destination": "/index.html" }
  ]
}
