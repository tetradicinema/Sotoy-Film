{
  "functions": {
    "api/sitemap.ts": {
      "includeFiles": "data/sitemap-snapshot.xml"
    }
  },
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/sitemap.csv", "destination": "/api/sitemap?format=csv" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/((?!api/|sitemap\\.xml|sitemap\\.csv|robots\\.txt|llms\\.txt|.*\\..*).*)", "destination": "/index.html" }
  ]
}
